# Copy to .env on the server and fill in. Never commit .env.
DOMAIN=manga.example.com
PUBLIC_URL=https://manga.example.com
# Other sites allowed to call the API from a browser, e.g. https://marinelj.github.io
CORS_ORIGINS=
PRICE_CENTS=3900
PRICE_LABEL=¥39
CURRENCY=cny
MAX_UPLOAD_MB=300

GEMINI_API_KEY=
# The directed book: Claude studies the frames, directs every panel and reviews every drawing; Gemini draws.
# It runs for every real book order while this key is set (BOOK_DIRECTOR=off switches it off).
# Without a key, orders get the older Gemini-only book. Key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-fable-5-2
# low | medium | high | xhigh | max. Higher reads the frames more carefully and costs more output tokens.
DIRECTOR_EFFORT=high
# At most this many fixes (an image edit or a new drawing, $0.14 each) per book, over DIRECTOR_FIX_ROUNDS rounds.
DIRECTOR_MAX_FIXES=10
DIRECTOR_FIX_ROUNDS=2
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# standard | batch. batch: book panels go through the Gemini Batch API at half price, ready within
# BATCH_MAX_WAIT_HOURS (often much sooner). The /admin page overrides it for new orders.
GEMINI_API_STYLE=standard
BATCH_MAX_WAIT_HOURS=24
# Redrawn video ("all" package)
VIDEO_IMAGE_MODEL=gemini-3.1-flash-image
VIDEO_CHECK_MODEL=gemini-3.5-flash-lite
VIDEO_MOTION_MODEL=gemini-omni-1.1-flash
VIDEO_KF_SIZE=1K
VIDEO_MAX_SECONDS=15
VIDEO_ORDER_BUDGET_USD=4.00

# Finished files are deleted this many days after the order is done (shown to buyers).
DOWNLOAD_DAYS=7
# Optional "your manga is ready" email with the order link. Off while SMTP_HOST is empty.
# Port 465 = SSL; for port 587 set SMTP_STARTTLS=1. SMTP_FROM defaults to SMTP_USER.
ORDER_PAGE_URL=https://marinelj.github.io/moment-manga/
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=

# demo | wechat | alipay | alipay_web | stripe
PAYMENT_PROVIDER=demo

# WeChat Pay v3 (Native)
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_APIV3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=/secrets/wechat_apiclient_key.pem

# Alipay AI web application payment. Set an approved CNY charge before enabling.
ALIPAY_ENV=sandbox
# live | sample. Empty means sample while ALIPAY_ENV=sandbox (no model costs), live otherwise.
GENERATION_MODE=
# 1 = allow sample files with real Alipay money (payment test only; remove before launch)
ALLOW_PRODUCTION_PAYMENT_TEST=
ALIPAY_BOOK_CENTS=
# Leave empty to keep the "all" package (book + video) off sale
ALIPAY_ALL_CENTS=
ALIPAY_NOTIFY_URL=
# For hosted sandbox deployments, store the entire private JSON as a secret variable.
ALIPAY_SANDBOX_JSON=
# Production only: all four values must belong to the same approved application.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# Existing Alipay precreate QR provider (PAYMENT_PROVIDER=alipay)
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY_PATH=/secrets/alipay_app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/secrets/alipay_public_key.pem

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional password for the Alipay refund/query admin routes only (the /admin debug page needs none). Make it up yourself (e.g. `openssl rand -hex 24`).
# It is not an Alipay credential. The old name ALIPAY_ADMIN_TOKEN still works.
ADMIN_TOKEN=

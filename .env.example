# Copy to .env on the server and fill in. Never commit .env.
DOMAIN=manga.example.com
PUBLIC_URL=https://manga.example.com
PRICE_CENTS=3900
PRICE_LABEL=¥39
CURRENCY=cny
MAX_UPLOAD_MB=300

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# demo | wechat | alipay | alipay_web | stripe
PAYMENT_PROVIDER=demo

# WeChat Pay v3 (Native)
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_APIV3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=/secrets/wechat_apiclient_key.pem

# Alipay AI web application payment. Set an approved CNY charge before enabling.
ALIPAY_ENV=sandbox
ALIPAY_BOOK_CENTS=
ALIPAY_NOTIFY_URL=
ALIPAY_ADMIN_TOKEN=
# Production only: all four values must belong to the same approved application.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# Existing Alipay precreate QR provider (PAYMENT_PROVIDER=alipay)
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY_PATH=/secrets/alipay_app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/secrets/alipay_public_key.pem

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
